# Required application secrets. Generate independent, long random values.
CATCHER_STANCE_ADMIN_TOKEN=replace-with-a-long-random-admin-token
CATCHER_STANCE_SECRET_KEY=replace-with-a-long-random-session-secret

# Docker runtime defaults. Keep the app private to the Compose network.
CATCHER_STANCE_SECURE_COOKIES=1
CATCHER_STANCE_HOST=0.0.0.0
CATCHER_STANCE_PORT=8000

# Set these to the host user's numeric IDs when using bind-mounted data.
APP_UID=1000
APP_GID=1000
